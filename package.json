{
  "name": "shared-household-chores",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:remote": "node scripts/e2e-remote.mjs",
    "test:all": "node scripts/test-all.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "observability:up": "docker compose --profile observability up -d --wait observability",
    "observability:down": "docker compose --profile observability stop observability"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "imports": {
    "#lib/builtin-categories": "./lib/builtin-categories.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@prisma/client": "^6.19.3",
    "@prisma/instrumentation": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
