{
  "uid": "chores-complete-journey",
  "title": "Complete a chore",
  "description": "The key journey: Complete clicks by outcome, latency, roll-overs, the journey logs and traces. Click a trace_id in a log line to open its trace; a trace's 'Logs for this span' opens its log lines.",
  "tags": ["shared-household-chores"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Completions (range)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chores_completions_total{chore_outcome=\"completed\"}[$__range]))",
          "legendFormat": "completed"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Refused or failed (range)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chores_completions_total{chore_outcome!=\"completed\"}[$__range]))",
          "legendFormat": "refused"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Roll-overs (range)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chores_rollovers_total[$__range]))",
          "legendFormat": "roll-overs"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 Complete duration (range)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(chores_complete_duration_milliseconds_bucket[$__range])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Completions by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chore_outcome) (increase(chores_completions_total[$__rate_interval]))",
          "legendFormat": "{{chore_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Complete duration p50 / p95 by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, chore_outcome) (rate(chores_complete_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{chore_outcome}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, chore_outcome) (rate(chores_complete_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{chore_outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Roll-overs by recurrence",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chore_recurrence) (increase(chores_rollovers_total[$__rate_interval]))",
          "legendFormat": "{{chore_recurrence}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars" } },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent Complete traces",
      "description": "Click a trace ID to open the trace; from a span, 'Logs for this span' shows its log lines.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"shared-household-chores\" && name=\"chores.complete\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Journey logs (click trace_id to open the trace)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"shared-household-chores\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
