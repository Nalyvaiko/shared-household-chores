# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
#
# Every variable below is also needed in production: set them in the Vercel
# project settings (Settings -> Environment Variables). See "Deploy to Vercel"
# in the README.

# PostgreSQL connection string the app uses at runtime (Prisma `url`).
#
# Local development with the bundled Docker Compose stack
# (see docker-compose.yml — same user / password / port):
DATABASE_URL="postgresql://chores:chores@localhost:5432/chores?schema=public"

# Direct (non-pooled) PostgreSQL connection string the Prisma CLI uses for
# migrations (Prisma `directUrl`). Locally there is no pooler, so it is the same
# value as DATABASE_URL.
DIRECT_URL="postgresql://chores:chores@localhost:5432/chores?schema=public"

# Hosted Postgres (Neon / Supabase / Railway) on Vercel:
#   DATABASE_URL = the provider's POOLED connection string (serverless functions
#                  open many short-lived connections). Neon: the "-pooler" host;
#                  Supabase: the transaction pooler on port 6543 — append
#                  `pgbouncer=true` for it.
#   DIRECT_URL   = the provider's DIRECT connection string, used only by
#                  `prisma migrate deploy` during the Vercel build.
# Railway has no built-in pooler: use the same connection string for both.
# Most providers require SSL:
# DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:PORT/DATABASE?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:PORT/DATABASE?sslmode=require"

# Auth.js secret used to sign and encrypt session tokens (JWT). Required.
# Generate a random value with either of:
#   npx auth secret          (writes AUTH_SECRET to .env.local for you)
#   openssl rand -base64 33
# Use a different value per environment; set it in Vercel's project settings
# for production.
AUTH_SECRET="replace-with-a-generated-secret"

# The app's public origin, used by Auth.js to build callback and redirect URLs.
# In production it MUST equal the deployed origin exactly (scheme + host, no
# trailing slash), e.g. https://your-app.vercel.app or your custom domain.
# Locally it is the dev server origin.
AUTH_URL="http://localhost:3000"

# Tells Auth.js to trust the request's Host header. Set it to `true` in Vercel.
# Locally it is only needed when running a production build
# (`npm run build && npm start`): Auth.js rejects untrusted hosts outside
# `next dev`.
# AUTH_TRUST_HOST=true
